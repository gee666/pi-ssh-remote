{
  "name": "oira666_pi-ssh-remote",
  "version": "0.2.15",
  "description": "Pi extension that transparently runs core tools on a selected SSH remote project.",
  "type": "module",
  "main": "./src/index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gee666/pi-ssh-remote.git"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "ssh",
    "remote"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": ">=1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "npm install --save-dev --ignore-scripts @earendil-works/pi-coding-agent@latest @earendil-works/pi-tui@latest && npm run typecheck",
    "test:evergreen": "npm test && node --experimental-strip-types --test test/test-tool-workflow.ts test/test-e2e.ts",
    "test": "node --experimental-strip-types --test test/test-skill-read.ts test/test-search-tools.ts test/test-modes.ts test/test-config.ts test/test-path-picker.ts test/test-putty.ts test/test-putty-import.ts test/test-connection-lifecycle.ts && node --experimental-strip-types test/test-integration.ts"
  }
}
